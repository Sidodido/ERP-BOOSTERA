generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  SALES_DIRECTOR
  SALES_REP
  TECH_LEAD
  DEVELOPER
  DESIGNER
  VIDEO_EDITOR
  ACCOUNTANT
  HR
}

enum UserStatus {
  PENDING
  EMAIL_UNVERIFIED
  APPROVED
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum ProspectStatus {
  NEW
  CONTACTED
  INTERESTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  CONVERTED
  NOT_INTERESTED
  LOST
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  CONTENTIOUS
  IN_PREPARATION
  NEW
  PENDING_PAYMENT
  TERMINATED
}

enum OfferType {
  STARTER
  SILVER
  GOLD
  CUSTOM
}

enum CallResult {
  NO_ANSWER
  UNREACHABLE
  INTERESTED
  NOT_INTERESTED
  CALLBACK_REQUESTED
  APPOINTMENT_BOOKED
}

enum AppointmentType {
  COMMERCIAL_VISIT
  VIDEO
  PHONE
  PRESENTATION
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CONVERTED
  LOST
}

enum ProjectStatus {
  NEW_REQUEST
  PLANNING
  IN_PRODUCTION
  CLIENT_VALIDATION
  REVISION
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  VALIDATED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BARIDIMOB
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum PaymentType {
  MONTHLY_SUBSCRIPTION
  SPONSOR_FACEBOOK
  SPONSOR_TIKTOK
  SPONSOR_INSTAGRAM
  CONTENT_CREATION
  VIDEO
  VOICE_OVER
  PRESENTATION
  WEBSITE
  RENEWAL
  OTHER
}

enum DepartmentType {
  COMMERCIAL
  PROSPECTION
  SALES
  CUSTOMER_RELATIONS
  MARKETING
  SOCIAL_MEDIA
  ADS
  CONTENT
  TECHNICAL
  DESIGN
  VIDEO
  DEVELOPMENT
  ADMINISTRATION
  FINANCE
  HR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  HALF_DAY
}

enum LeaveType {
  ANNUAL
  SICK
  PERMISSION
  SPECIAL
}

enum LeaveStatus {
  PENDING
  APPROVED_MANAGER
  CONFIRMED_HR
  REJECTED
}

enum CommissionRuleType {
  NEW_CLIENT_PERCENTAGE
  RECURRING_MONTHLY_PERCENTAGE
  SPONSOR_PERCENTAGE
  FIXED_AMOUNT
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

// ----------------------------------------------------
// AUTH, USERS & AUDIT
// ----------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(SALES_REP)
  avatarUrl    String?
  phone        String?
  isActive     Boolean   @default(true)
  status       UserStatus @default(ACTIVE)

  emailVerified                   Boolean   @default(true)
  emailVerifiedAt                 DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  resetPasswordToken              String?   @unique
  resetPasswordTokenExpiresAt     DateTime?

  pendingEmail                    String?
  emailChangeToken                String?   @unique
  emailChangeTokenExpiresAt       DateTime?

  rejectionReason                 String?
  rejectedAt                      DateTime?
  rejectedById                    String?
  approvedAt                      DateTime?
  approvedById                    String?

  lastLoginAt                     DateTime?
  passwordChangedAt               DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  employee             Employee?
  assignedProspects    Prospect[]        @relation("ProspectAssignee")
  createdProspects     Prospect[]        @relation("ProspectCreator")
  managedClients       Client[]          @relation("ClientManager")
  loggedCalls          Call[]
  conductedAppointments Appointment[]
  followUps            FollowUp[]
  managedProjects      Project[]         @relation("ProjectManager")
  assignedTasks        ProjectTask[]     @relation("TaskAssignee")
  recordedPayments     Payment[]         @relation("PaymentRecorder")
  uploadedDocuments    Document[]        @relation("DocumentUploader")
  auditLogs            AuditLog[]
  notifications        Notification[]
  managedTools         ToolSubscription[]
  assignedAssets       Asset[]
  approvedLeaves       LeaveRequest[]    @relation("LeaveApprover")
  conductedReviews     PerformanceReview[] @relation("Reviewer")
  sentChatMessages     ChatMessage[]     @relation("SentChatMessages")
  receivedChatMessages ChatMessage[]     @relation("ReceivedChatMessages")

  @@index([role])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // "CREATE", "UPDATE", "DELETE", "LOGIN", "CONVERT", "PAYMENT_RECORDED"
  module     String   // "AUTH", "PROSPECTS", "CLIENTS", "CALLS", "FINANCE", "HR"
  entityId   String?
  details    String?  // JSON string of changes
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // "CALL", "APPOINTMENT", "FOLLOWUP", "PAYMENT", "TASK", "SYSTEM"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ChatMessage {
  id          String    @id @default(uuid())
  content     String
  senderId    String
  recipientId String?
  channel     String    @default("general") // "general", "commercial", "technique-production", "annonces"
  fileUrl     String?
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  sender      User      @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?     @relation("ReceivedChatMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([channel, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, createdAt])
}

// ----------------------------------------------------
// CRM, PROSPECTS, CLIENTS & PIPELINE
// ----------------------------------------------------

model Prospect {
  id               String         @id @default(uuid())
  companyName      String
  contactName      String?
  phone            String
  email            String?
  sector           String         // "Cabinet médical", "Voyage", "Hôtel", "Restaurant", etc.
  wilaya           String         // "Alger", "Oran", "Constantine", etc.
  address          String?
  status           ProspectStatus @default(NEW)
  rawState         String?        // Original ETAT from Excel ("INTERRESE", "JSP", etc.)
  source           String?        @default("Prospection directe")
  notes            String?        // REMARQUE
  
  // Historical / import specific columns
  prospectionDate  DateTime?      // DATE
  callStatus       String?        // APPEL ("EFFECTUE", "ne repend pas", "injoignable")
  response         String?        // REPENSE (réponse / échange)

  assignedToId     String?
  createdById      String?
  convertedClientId String?       @unique

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  assignedTo       User?          @relation("ProspectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy        User?          @relation("ProspectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  convertedClient  Client?        @relation("ProspectConversion", fields: [convertedClientId], references: [id], onDelete: SetNull)
  calls            Call[]
  appointments     Appointment[]
  followUps        FollowUp[]

  @@index([sector])
  @@index([wilaya])
  @@index([status])
  @@index([assignedToId])
  @@index([createdById])
  @@index([callStatus])
  @@index([createdAt])
  @@index([phone])
}

model Client {
  id            String       @id @default(uuid())
  companyName   String
  brandName     String?
  contactName   String?
  phone         String
  email         String?
  facebook      String?
  instagram     String?
  address       String?
  sector        String
  wilaya        String?
  status        ClientStatus @default(NEW)
  offerType     OfferType    @default(STARTER)
  hasWebsite    Boolean      @default(false)
  
  contractStart DateTime?
  contractEnd   DateTime?
  contractValue Decimal      @default(0) @db.Decimal(12, 2)
  monthlyFee    Decimal      @default(0) @db.Decimal(12, 2)
  notes         String?
  
  assignedToId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  assignedTo    User?        @relation("ClientManager", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedFrom Prospect?    @relation("ProspectConversion")
  calls         Call[]
  appointments  Appointment[]
  projects      Project[]
  invoices      Invoice[]
  payments      Payment[]
  documents     Document[]
  sponsorCampaigns SponsorCampaign[]
  paymentSchedules PaymentSchedule[]
  commissions   Commission[]

  @@index([status])
  @@index([sector])
  @@index([assignedToId])
  @@index([createdAt])
}

model Call {
  id              String     @id @default(uuid())
  prospectId      String?
  clientId        String?
  userId          String
  result          CallResult
  comment         String?
  durationSeconds Int?       @default(0)
  calledAt        DateTime   @default(now())
  createdAt       DateTime   @default(now())

  prospect        Prospect?  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client          Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([calledAt])
  @@index([result])
  @@index([prospectId])
  @@index([clientId])
  @@index([userId, calledAt])
}

model Appointment {
  id          String            @id @default(uuid())
  title       String
  type        AppointmentType   @default(COMMERCIAL_VISIT)
  status      AppointmentStatus @default(SCHEDULED)
  startTime   DateTime
  endTime     DateTime
  durationMin Int               @default(60)
  location    String?
  notes       String?
  
  prospectId  String?
  clientId    String?
  userId      String

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  prospect    Prospect?         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
  @@index([status])
  @@index([prospectId])
  @@index([clientId])
}

model FollowUp {
  id          String         @id @default(uuid())
  prospectId  String
  userId      String
  stepNumber  Int            // 1 (+3 jours), 2 (+7 jours), 3 (+15 jours)
  scheduledAt DateTime
  status      FollowUpStatus @default(SCHEDULED)
  notes       String?
  completedAt DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  prospect    Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([status])
  @@index([prospectId])
  @@index([userId])
  @@index([userId, status])
  @@index([status, scheduledAt])
}

// ----------------------------------------------------
// PRODUCTION & PROJECTS
// ----------------------------------------------------

model Project {
  id          String        @id @default(uuid())
  clientId    String
  name        String
  code        String        @unique // e.g. "PRJ-2026-001"
  description String?
  status      ProjectStatus @default(NEW_REQUEST)
  managerId   String?
  startDate   DateTime?
  deadline    DateTime?
  budget      Decimal       @default(0) @db.Decimal(12, 2)
  currency    String        @default("DA")
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  tasks       ProjectTask[]
  invoices    Invoice[]
  documents   Document[]
  costs       ProjectCost[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([clientId])
  @@index([managerId])
}

model ProjectTask {
  id              String       @id @default(uuid())
  projectId       String
  assigneeId      String?
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?
  timeSpentHours  Decimal      @default(0) @db.Decimal(6, 2)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model Document {
  id          String   @id @default(uuid())
  name        String
  fileUrl     String
  fileType    String   // "PDF", "IMAGE", "VIDEO", "EXCEL", "OTHER"
  fileSize    Int      // bytes
  category    String   // "CONTRACT", "BRIEF", "INVOICE", "MEDIA", "HR", "SUPPLIER"
  
  clientId    String?
  projectId   String?
  uploadedById String?
  
  createdAt   DateTime @default(now())

  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy  User?    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([category])
  @@index([uploadedById])
}

// ----------------------------------------------------
// FINANCE, INVOICING & SPONSOR CAMPAIGNS
// ----------------------------------------------------

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. "FAC-2026-0001"
  clientId      String
  projectId     String?
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2) // e.g. 19% or 0%
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]
  schedules     PaymentSchedule[]
  commissions   Commission[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String?
  clientId      String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentType   PaymentType   @default(MONTHLY_SUBSCRIPTION)
  reference     String?       // Transaction ID, BaridiMob receipt number, etc.
  status        PaymentStatus @default(COMPLETED)
  paymentDate   DateTime      @default(now())
  notes         String?
  recordedById  String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recordedBy    User?         @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([invoiceId])
  @@index([recordedById])
  @@index([paymentDate])
  @@index([paymentMethod])
}

model PaymentSchedule {
  id          String   @id @default(uuid())
  invoiceId   String?
  clientId    String
  dueDate     DateTime
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("PENDING") // PENDING, PAID, OVERDUE
  alertSentJ7 Boolean  @default(false)
  alertSentJ1 Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([clientId])
  @@index([dueDate])
  @@index([status])
}

model SponsorCampaign {
  id          String   @id @default(uuid())
  clientId    String
  platform    String   // "Facebook", "Instagram", "TikTok", "Google Ads"
  budget      Decimal  @db.Decimal(12, 2)
  durationDays Int
  startDate   DateTime
  endDate     DateTime
  amountPaid  Decimal  @default(0) @db.Decimal(12, 2)
  remaining   Decimal  @default(0) @db.Decimal(12, 2)
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([platform])
}

// ----------------------------------------------------
// HR, EMPLOYEES, ATTENDANCE & COMMISSIONS
// ----------------------------------------------------

model Employee {
  id             String         @id @default(uuid())
  userId         String         @unique
  firstName      String
  lastName       String
  phone          String?
  email          String?
  address        String?
  birthDate      DateTime?
  hireDate       DateTime       @default(now())
  position       String         // Commercial, Community Manager, Designer, Monteur vidéo, etc.
  department     DepartmentType @default(COMMERCIAL)
  baseSalary     Decimal        @default(0) @db.Decimal(12, 2)
  isActive       Boolean        @default(true)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  salaryPayments SalaryPayment[]
  commissions    Commission[]
  goals          EmployeeGoal[]
  reviews        PerformanceReview[]

  @@index([department])
  @@index([position])
}

model Attendance {
  id           String           @id @default(uuid())
  employeeId   String
  date         DateTime         @db.Date
  clockIn      DateTime?
  clockOut     DateTime?
  breakMinutes Int              @default(0)
  status       AttendanceStatus @default(PRESENT)
  notes        String?

  createdAt    DateTime         @default(now())

  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  employeeId  String
  type        LeaveType   @default(ANNUAL)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  daysCount   Int         @default(1)
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedById String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy  User?       @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([approvedById])
  @@index([status])
}

model CommissionRule {
  id             String             @id @default(uuid())
  name           String             // e.g. "Nouveau client 10%", "Abonnement 5%", "Sponsor 7%"
  ruleType       CommissionRuleType @default(NEW_CLIENT_PERCENTAGE)
  ratePercentage Decimal            @db.Decimal(5, 2) // e.g. 10.00%
  isActive       Boolean            @default(true)
  description    String?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Commission {
  id          String   @id @default(uuid())
  employeeId  String
  clientId    String?
  invoiceId   String?
  amount      Decimal  @db.Decimal(12, 2)
  rateApplied Decimal  @db.Decimal(5, 2)
  status      String   @default("PENDING") // PENDING, APPROVED, PAID
  notes       String?
  earnedDate  DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([status])
}

model SalaryPayment {
  id          String   @id @default(uuid())
  employeeId  String
  month       Int      // 1 to 12
  year        Int      // e.g. 2026
  baseSalary  Decimal  @db.Decimal(12, 2)
  primes      Decimal  @default(0) @db.Decimal(12, 2)
  commissions Decimal  @default(0) @db.Decimal(12, 2)
  bonuses     Decimal  @default(0) @db.Decimal(12, 2)
  deductions  Decimal  @default(0) @db.Decimal(12, 2)
  netSalary   Decimal  @db.Decimal(12, 2)
  status      String   @default("DRAFT") // DRAFT, PAID
  paidAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
}

model EmployeeGoal {
  id            String   @id @default(uuid())
  employeeId    String
  month         Int
  year          Int
  metric        String   // "APPELS", "RENDEZ_VOUS", "CLIENTS", "CA", "CREATIONS", "VIDEOS"
  targetValue   Decimal  @db.Decimal(12, 2)
  achievedValue Decimal  @default(0) @db.Decimal(12, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, year, month])
}

model PerformanceReview {
  id              String   @id @default(uuid())
  employeeId      String
  reviewerId      String
  scorePercentage Decimal  @db.Decimal(5, 2) // 0 to 100%
  commercialScore Decimal? @db.Decimal(5, 2)
  technicalScore  Decimal? @db.Decimal(5, 2)
  feedback        String?
  reviewDate      DateTime @default(now())

  createdAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer        User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([reviewerId])
}

// ----------------------------------------------------
// SUPPLIERS, EXPENSES, ASSETS, STOCK & PROFITABILITY
// ----------------------------------------------------

model Supplier {
  id          String          @id @default(uuid())
  name        String
  company     String?
  phone       String?
  email       String?
  address     String?
  category    String          // Production (vidéaste, designer), Digital (hosting, SaaS), Publicité, Admin
  notes       String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orders      PurchaseOrder[]

  @@index([category])
}

model PurchaseOrder {
  id         String   @id @default(uuid())
  supplierId String
  projectId  String?
  amount     Decimal  @db.Decimal(12, 2)
  category   String
  status     String   @default("ORDERED") // REQUESTED, APPROVED, ORDERED, RECEIVED, PAID
  orderedAt  DateTime @default(now())

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([projectId])
}

model Expense {
  id            String        @id @default(uuid())
  category      String        // Marketing (Meta Ads, Google), Production, Tech, RH, Bureau
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @default(now())
  description   String
  paymentMethod PaymentMethod @default(CASH)
  receiptUrl    String?
  projectId     String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
  @@index([date])
}

model ToolSubscription {
  id            String   @id @default(uuid())
  name          String   // Canva, Adobe, ChatGPT, CapCut, Hosting, etc.
  category      String
  monthlyCost   Decimal  @db.Decimal(12, 2)
  renewalDate   DateTime
  paymentCard   String?  // e.g. "Carte Gold ****1234"
  status        String   @default("ACTIVE")
  managerId     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  manager       User?    @relation(fields: [managerId], references: [id], onDelete: SetNull)

  @@index([managerId])
  @@index([renewalDate])
}

model Asset {
  id           String      @id @default(uuid())
  name         String      // Caméra Sony A7IV, Drone DJI Mini 4 Pro, Micro Rode, etc.
  serialNumber String?     @unique
  category     String      // Photo, Vidéo, Audio, Informatique, Éclairage
  purchaseDate DateTime?
  price        Decimal     @default(0) @db.Decimal(12, 2)
  status       AssetStatus @default(AVAILABLE)
  assignedToId String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedTo   User?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([status])
}

model InventoryItem {
  id              String          @id @default(uuid())
  name            String          // Flyers, Cartes de visite, Goodies, etc.
  sku             String?         @unique
  quantityInStock Int             @default(0)
  minThreshold    Int             @default(10)
  unitPrice       Decimal         @default(0) @db.Decimal(12, 2)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  movements       StockMovement[]

  @@index([quantityInStock])
}

model StockMovement {
  id        String            @id @default(uuid())
  itemId    String
  type      StockMovementType
  quantity  Int
  reason    String?
  userId    String?

  createdAt DateTime          @default(now())

  item      InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model ProjectCost {
  id          String   @id @default(uuid())
  projectId   String
  costType    String   // "EMPLOYEE_TIME", "FREELANCER", "ADVERTISING", "SOFTWARE", "HARDWARE", "OTHER"
  amount      Decimal  @db.Decimal(12, 2)
  description String
  date        DateTime @default(now())

  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProductionTaskTemplate {
  id           String        @id @default(uuid())
  title        String
  category     String        @default("VIDEO") // VIDEO, AUDIO, DESIGN, WEB, ADS, OTHER
  part         String        @default("PART_1") // PART_1 ou PART_2
  partLabel    String?
  role         Role?
  defaultHours Decimal       @default(2.0) @db.Decimal(5, 2)
  priority     TaskPriority  @default(MEDIUM)
  description  String?
  isActive     Boolean       @default(true)
  orderIndex   Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([part])
  @@index([isActive])
}
